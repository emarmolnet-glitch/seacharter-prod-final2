# UN Comtrade subscription key used by the client-side competitiveness radar.
VITE_UN_COMTRADE_API_KEY=

# Shared Datalastic provider for Data Bridge and calculator vessel lookups.
DATALASTIC_API_KEY=
DATALASTIC_API_BASE_URL=https://api.datalastic.com/api/v0

# Live AIS provider used by /api/fleet/live-ais: auto, openships, or aisstream.
LIVE_AIS_PROVIDER=auto
LIVE_AIS_TIMEOUT_MS=15000

# OpenShips REST bounding-box provider (server-side only).
OPENSHIPS_API_URL=https://api.openships.de/v1
OPENSHIPS_API_KEY=
OPENSHIPS_API_KEY_HEADER=Authorization
OPENSHIPS_API_KEY_PREFIX="Bearer "
# OPENSHIPS_API_KEY_QUERY_PARAM=
# OPENSHIPS_DISABLE_DOCUMENTED_FALLBACK=false

# AISStream WebSocket snapshot provider (server-side only).
AISSTREAM_API_KEY=
AISSTREAM_WS_URL=wss://stream.aisstream.io/v0/stream
AISSTREAM_SNAPSHOT_MS=7000

# Resend gateway used by /api/send-email to dispatch Data Bridge DRAFT_EMAIL drafts.
RESEND_API_KEY=
# Static generic SeaCharter sender; must belong to a domain verified in Resend.
RESEND_FROM_EMAIL="SeaCharter Core PRO <no-reply@seacharter.app>"
