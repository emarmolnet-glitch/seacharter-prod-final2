# UN Comtrade subscription key used by the client-side competitiveness radar.
VITE_UN_COMTRADE_API_KEY=

# Authenticated HiFleet getShipDatav3 (or equivalent single-IMO endpoint).
# Configure at least one of HIFLEET_AUTHORIZATION, HIFLEET_SESSION_COOKIE, or HIFLEET_API_TOKEN.
HIFLEET_GET_SHIP_DATA_URL=
HIFLEET_HTTP_METHOD=GET
HIFLEET_IMO_QUERY_PARAM=imo
HIFLEET_AUTHORIZATION=
HIFLEET_SESSION_COOKIE=
HIFLEET_API_TOKEN=
HIFLEET_API_TOKEN_HEADER=X-API-Key
HIFLEET_CSRF_TOKEN=
HIFLEET_CSRF_HEADER=X-CSRF-Token
HIFLEET_TIMEOUT_MS=12000
